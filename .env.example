# ==============================================================================
# CheckInn Environment Configuration Template
# Copy this file to .env (or configure in your deployment environment)
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# Database Configuration (PostgreSQL / Supabase)
DB_URL=jdbc:postgresql://localhost:5432/checkinn_db
DB_USERNAME=postgres
DB_PASSWORD=your_database_password

# JWT Authentication
# Must be at least 32 characters (256 bits) for HMAC-SHA
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long

# Mail Service (SMTP for booking confirmations & notifications)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_app_password

# Frontend URL / CORS Allowed Origin
FRONTEND_URL=http://localhost:5173

# Optional Feature Flags
CHECKINN_INVENTORY_SEED_ENABLED=true

# Frontend Client Configuration (for React / Vite in checkinn-frontend)
VITE_API_BASE_URL=http://localhost:8080/api
